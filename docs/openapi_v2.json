  "info": {
    "description": "SLA-aware ticket allocation with an auditable decision history. Phase 1 covers authentication, tickets, agents and the audit trail; recommendation and rescore endpoints arrive in later phases.",
    "title": "SLA-aware service desk (v2)",
    "version": "2.0.0-phase1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/agents": {
      "get": {
        "operationId": "list_agents_api_v2_agents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Agents",
        "tags": [
          "administration"
        ]
      },
      "post": {
        "operationId": "create_agent_api_v2_agents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Agent",
        "tags": [
          "administration"
        ]
      }
    },
    "/api/v2/agents/{agent_id}": {
      "patch": {
        "operationId": "patch_agent_api_v2_agents__agent_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "agent_id",
            "required": true,
            "schema": {
              "title": "Agent Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Patch Agent",
        "tags": [
          "administration"
        ]
      }
    },
    "/api/v2/agents/{agent_id}/skills": {
      "put": {
        "description": "Set an agent's skills to exactly this list.\n\nReplacement rather than merge: eligibility is decided by these rows, and a\nskill that was removed has to actually disappear or the dispatcher would\nkeep seeing an agent proposed for work they no longer do.",
        "operationId": "replace_skills_api_v2_agents__agent_id__skills_put",
        "parameters": [
          {
            "in": "path",
            "name": "agent_id",
            "required": true,
            "schema": {
              "title": "Agent Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/SkillIn"
                },
                "title": "Payload",
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Replace Skills",
        "tags": [
          "administration"
        ]
      }
    },
    "/api/v2/health": {
      "get": {
        "description": "Liveness, the dialect in use, and whether migrations have been run.",
        "operationId": "health_api_v2_health_get",
